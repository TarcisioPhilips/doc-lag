{
  "name": "doc-lag",
  "version": "0.2.0",
  "description": "Detect documentation that may be stale after a code change, with traceable evidence.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "doc-lag": "dist/cli.js",
    "doc-lag-mcp": "dist/mcp/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "PROJECT_SPEC.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan": "tsx src/cli.ts scan",
    "mcp": "tsx src/cli.ts mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^14.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
